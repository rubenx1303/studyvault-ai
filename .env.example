# Copiar como .env (excluido de Git). No poner nunca aquí usuario ni contraseña del campus.
# Deja comentadas (#) las claves que no uses: una clave vacía (CLAVE=) no equivale a «sin definir».

# personal | demo  (demo usa datos ficticios y nunca se conecta a ningún campus)
STUDYVAULT_MODE=demo
# API_PORT=
# HOST=
# LOG_LEVEL=

# Carpeta de datos (por defecto %LOCALAPPDATA%\StudyVault en Windows; ./data en otros sistemas)
# STUDYVAULT_HOME=
# DATA_DIR=

# Fuente Moodle (solo lectura). Requiere el servicio web móvil de Moodle habilitado en el sitio.
# MOODLE_BASE_URL=https://moodle.example.edu
# MOODLE_BROWSER_CHANNEL=
# MOODLE_INCLUDE_PRIVATE_MESSAGES=

# Embeddings: local | openai-compatible | ollama
EMBEDDINGS_PROVIDER=local
# EMBEDDINGS_MODEL=
# EMBEDDINGS_BASE_URL=
# EMBEDDINGS_API_KEY=

# LLM: none | ollama | openai-compatible | azure-openai | anthropic
LLM_PROVIDER=none
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_API_KEY=
# AZURE_OPENAI_API_VERSION=

# Transcripción: local | openai-compatible | azure | none
TRANSCRIPTION_PROVIDER=none
# WHISPER_CPP_BIN=
# WHISPER_MODEL=
# WHISPER_VAD_MODEL=
# FFMPEG_PATH=
# TRANSCRIPTION_BASE_URL=
# TRANSCRIPTION_MODEL=
# TRANSCRIPTION_API_KEY=
# AZURE_SPEECH_ENDPOINT=
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_LOCALE=
# RECORDING_MAX_MB=

# Avisos para Power Automate: carpeta local (sincronizada con OneDrive) o «off»
# POWER_AUTOMATE_OUTBOX=
