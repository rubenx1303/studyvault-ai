{
  "name": "@studyvault/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "demo:seed": "tsx src/demo/seed.ts",
    "moodle:login": "tsx --env-file-if-exists=../../.env src/sources/moodle/loginCli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "sync": "tsx --env-file-if-exists=../../.env src/syncCli.ts",
    "daily": "tsx --env-file-if-exists=../../.env src/syncCli.ts --digest",
    "daily:if-due": "tsx --env-file-if-exists=../../.env src/syncCli.ts --digest --if-due"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^10.1.7",
    "@huggingface/transformers": "^4.3.1",
    "@studyvault/shared": "*",
    "fastify": "^5.12.7",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.64.1",
    "word-extractor": "^1.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/word-extractor": "^1.0.6",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
